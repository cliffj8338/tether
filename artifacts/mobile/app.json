{
  "expo": {
    "name": "Tether",
    "slug": "tether",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon-1024.png",
    "scheme": "tether",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F6FA"
    },
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/icons/icon-1024.png",
      "bundleIdentifier": "app.tetherapp.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Tether needs camera access to take photos for messages.",
        "NSPhotoLibraryUsageDescription": "Tether needs photo library access to share images.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/icons/icon-512.png",
      "package": "app.tetherapp.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/android-fg.png",
        "backgroundImage": "./assets/icons/android-bg.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon-32.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://tetherapp.app"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/icon-512.png",
          "color": "#6B9E8A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    },
    "owner": "tether-app"
  }
}
